{
  "manifest_version": 3,
  "name": "Rake Survival",
  "version": "1.0.0",
  "description": "Nightly survival game against a hunting rake.",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_title": "Rake Survival",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": ["models/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
